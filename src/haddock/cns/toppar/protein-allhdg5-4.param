! -----------------------------------------------------------------------
! IVA Isovaline: CH0 (quaternary alpha-carbon) parameters
! Angles: Butcher et al. 2013, Acta Cryst E69 o1829 (crystal structure)
! Added Mar 2026
! -----------------------------------------------------------------------

! Nonbonded -- same as CHAS (both are quaternary C, no implicit H)
NONBONDED  CH0    0.10000 3.29633 0.10000 3.02906

! Bonds
BOND  C    CH0    1000.000 {sd=0.001}   1.525   ! C(=O)-CA
BOND  CH0  NH1    1000.000 {sd=0.001}   1.458   ! CA-N
BOND  CH0  CH3E   1000.000 {sd=0.001}   1.521   ! CA-CB2 (methyl)
BOND  CH0  CH2E   1000.000 {sd=0.001}   1.530   ! CA-CB1 (ethyl)

! Angles around CH0 center (Butcher et al. 2013 crystal structure, avg=109.45 ~ tetrahedral)
ANGLe  C    CH0  NH1      500.00 {sd=0.031}  109.1   ! N-CA-C
ANGLe  C    CH0  CH3E     500.00 {sd=0.031}  110.7   ! C-CA-CB2
ANGLe  C    CH0  CH2E     500.00 {sd=0.031}  108.9   ! C-CA-CB1
ANGLe  NH1  CH0  CH3E     500.00 {sd=0.031}  108.1   ! N-CA-CB2
ANGLe  NH1  CH0  CH2E     500.00 {sd=0.031}  108.6   ! N-CA-CB1
ANGLe  CH3E CH0  CH2E     500.00 {sd=0.031}  111.3   ! CB2-CA-CB1
! Angles with CH0 as terminal atom (values from CH1E equivalents)
ANGLe  O    C    CH0      500.00 {sd=0.031}  120.8258 ! O-C(carbonyl)-CA
ANGLe  CH0  C    NH1      500.00 {sd=0.031}  116.1998 ! CA-C-N(next residue)
ANGLe  CH0  C    NH2      500.00 {sd=0.031}  116.1998 ! CA-C-N(C-term amide)
ANGLe  CH0  C    N        500.00 {sd=0.031}  116.9940 ! CA-C-N(pro next)
ANGLe  C    NH1  CH0      500.00 {sd=0.031}  121.6541 ! C(prev)-N-CA
ANGLe  CH0  NH1  H        500.00 {sd=0.031}  119.2367 ! CA-N-HN
ANGLe  CH0  CH2E CH3E     500.00 {sd=0.031}  113.7404 ! CA-CB1-CG1
ANGLe  CH0  CH2E HA       500.00 {sd=0.031}  109.2833 ! CA-CB1-HBx
ANGLe  CH0  CH3E HA       500.00 {sd=0.031}  109.4726 ! CA-CB2-HBx

! Carbonyl planarity (C as center, equiv to C CH1E NH1 O at line 1056)
IMPRoper  C    CH0  NH1   O       500.00  0    0.0000  ! planar carbonyl (internal IVA)
IMPRoper  C    CH0  NH2   O       500.00  0    0.0000  ! planar carbonyl (C-term amide)
! Peptide bond planarity -- N-H (equiv NH1 C CH1E H at line 1066)
IMPRoper  NH1  C    CH0   H       500.00  0    0.0000  ! N-H planarity (IVA N)
! Peptide bond planarity -- omega (equiv CH1E C NH1 CH1E → 180 at line 1086)
IMPRoper  CH1E C    NH1   CH0     500.00  0    180.0000 ! omega: standard-AA -> IVA
IMPRoper  CH2G C    NH1   CH0     500.00  0    180.0000 ! omega: GLY -> IVA
IMPRoper  CH0  C    NH1   CH1E    500.00  0    180.0000 ! omega: IVA -> standard-AA
IMPRoper  CH0  C    NH1   CH3E    500.00  0    180.0000 ! omega: IVA -> NME
IMPRoper  CH0  C    NH1   CH2G    500.00  0    180.0000 ! omega: IVA -> GLY
IMPRoper  CH0  C    N     CH2P    500.00  0    180.0000 ! omega: IVA -> PRO
! C-terminal amide planarity (equiv CH1E C NH2 H at line 858)
IMPRoper  CH0  C    NH2   H       500.00  0    0.0000  ! CA-C-N(amide)-H planarity

! Chirality -- 35.264 deg = arctan(1/sqrt(2)), tetrahedral out-of-plane angle
! Center atom (CA=CH0) listed first, three substituents follow (DRG convention)
IMPRoper  CH0  CH3E  NH1  CH2E   400.00  0   35.264  ! L-IVA chirality CA
IMPRoper  CH0  NH1   CH3E CH2E   400.00  0   35.264  ! D-IVA chirality CA (after LTOD_IVA)

! Stereo (ALA convention: HA HA <central> <4th-substituent>)
IMPRoper  HA   HA   CH0   HA      500.00  0   35.264  ! CB2 methyl stereo
IMPRoper  HA   HA   CH0   CH3E    500.00  0   35.264  ! CB1 methylene stereo

! Dihedrals (NH1-CH0-CH3E-HA and CH2E-CH0-NH1-H covered by lines 1239-1241 via reverse)
DIHEdral  O    C    CH0   NH1    2.00  2  0.0000   ! O-C(carbonyl)-CA-N torsion
DIHEdral  CH0  CH2E CH3E  HA     1.00  3  0.0000   ! CA-CB1-CG1-HG stagger
! Backbone MULT 6 dihedrals for CH0 (equiv to CH1E entries at lines 1343-1397)
! Psi: CB-CA-C-O (0.375 coefficients, equiv line 1343/1345)
DIHEdral  CH2E  CH0  C    O      MULT 6   0.375  1 0.0000 0.3  2 0.0000  0.225  3 0.0000  0.15  4 0.0000  0.075  5 0.0000  0.0375  6 0.0000 !CB1-CA-C-O
DIHEdral  CH3E  CH0  C    O      MULT 6   0.375  1 0.0000 0.3  2 0.0000  0.225  3 0.0000  0.15  4 0.0000  0.075  5 0.0000  0.0375  6 0.0000 !CB2-CA-C-O
! Psi: CB-CA-C-N (0.5 coefficients, equiv lines 1354-1375)
DIHEdral  CH2E  CH0  C    NH1    MULT 6   0.5   1 0.0000 0.4  2 0.0000  0.3   3 0.0000  0.2  4 0.0000  0.1   5 0.0000  0.05   6 0.0000 !CB1-CA-C-N(next)
DIHEdral  CH3E  CH0  C    NH1    MULT 6   0.5   1 0.0000 0.4  2 0.0000  0.3   3 0.0000  0.2  4 0.0000  0.1   5 0.0000  0.05   6 0.0000 !CB2-CA-C-N(next)
DIHEdral  CH2E  CH0  C    NH2    MULT 6   0.5   1 0.0000 0.4  2 0.0000  0.3   3 0.0000  0.2  4 0.0000  0.1   5 0.0000  0.05   6 0.0000 !CB1-CA-C-N(C-term amide)
DIHEdral  CH3E  CH0  C    NH2    MULT 6   0.5   1 0.0000 0.4  2 0.0000  0.3   3 0.0000  0.2  4 0.0000  0.1   5 0.0000  0.05   6 0.0000 !CB2-CA-C-N(C-term amide)
DIHEdral  CH2E  CH0  C    N      MULT 6   0.5   1 0.0000 0.4  2 0.0000  0.3   3 0.0000  0.2  4 0.0000  0.1   5 0.0000  0.05   6 0.0000 !CB1-CA-C-N(PRO next)
DIHEdral  CH3E  CH0  C    N      MULT 6   0.5   1 0.0000 0.4  2 0.0000  0.3   3 0.0000  0.2  4 0.0000  0.1   5 0.0000  0.05   6 0.0000 !CB2-CA-C-N(PRO next)
! Phi: C(prev)-N-CA-X (equiv lines 1379/1392-1394)
DIHEdral  C     NH1  CH0  C      MULT 6   0.375  1 0.0000 0.3  2 0.0000  0.225  3 0.0000  0.15  4 0.0000  0.075  5 0.0000  0.0375  6 0.0000 !phi: prev-N-CA-C
DIHEdral  C     NH1  CH0  CH3E   MULT 6   0.5   1 0.0000 0.4  2 0.0000  0.3   3 0.0000  0.2  4 0.0000  0.1   5 0.0000  0.05   6 0.0000 !phi: prev-N-CA-CB2
DIHEdral  C     NH1  CH0  CH2E   MULT 6   0.5   1 0.0000 0.4  2 0.0000  0.3   3 0.0000  0.2  4 0.0000  0.1   5 0.0000  0.05   6 0.0000 !phi: prev-N-CA-CB1

! -----------------------------------------------------------------------
! ADI/AZH azide nitrogen types: NPA (proximal), NPB (middle,+), NPC (terminal,-)
! Geometry from ATB AWXF B3LYP/6-31G*; GROMOS 54A7 NB params converted to CNS units
! (epsilon: kJ/mol -> kcal/mol /4.184; sigma -> Rmin/2 = sigma*2^(1/6)/2)
! -----------------------------------------------------------------------

NONBONDED NPA   0.03343  2.1880  0.03343  1.9660  ! proximal azide N (GROMOS NOpt)
NONBONDED NPB   0.03343  2.1880  0.03343  1.9660  ! middle azide N+  (GROMOS NOpt)
NONBONDED NPC   0.03410  2.2840  0.03410  2.0550  ! terminal azide N- (GROMOS NPri)

! Bonds (ATB equilibrium lengths; stiff allhdg-style force constant)
BOND  CH2E NPA   1000.000  1.480   ! CB1-NN1 C-N bond (sp2 N)
BOND  NPA  NPB   1000.000  1.230   ! NN1=NN2 double bond
BOND  NPB  NPC   1000.000  1.140   ! NN2=NN3 triple bond character

! Angles (ATB equilibrium; 500 kcal/mol/rad^2 consistent with allhdg)
ANGLe CH0  CH2E NPA   500.00  111.0    ! CA-CB1-NN1 (sp3 C angle)
ANGLe HA   CH2E NPA   500.00  109.5    ! HB-CB1-NN1
ANGLe CH2E NPA  NPB   500.00  116.0    ! CB1-NN1=NN2 (ATB 116.0 deg)
ANGLe NPA  NPB  NPC   500.00  174.0    ! NN1=NN2=NN3 near-linear (ATB 174.0 deg)

! Omega planarity: ADI/AZH (CH0) neighbours same as IVA -- already covered by existing
! CH1E C NH1 CH0 / CH0 C NH1 CH1E entries in the CH0 block above

! Chirality for D-ADI/D-AZH (center-first DRG convention, D-config)
! CH0 NH1 CH3E CH2E -> 35.264 already in param; same types used here

! Impropers (azide NN1 planarity; NN1 is sp2 with lone pair into N=N pi)
IMPRoper CH2E NPA  NPB  HA    500.00  0   0.0000  ! NN1 sp2 out-of-plane

! Side-chain dihedrals for azide
DIHEdral NH1  CH0  CH2E NPA   MULT 6  0.5 1 0.0  0.4 2 0.0  0.3 3 0.0  0.2 4 0.0  0.1 5 0.0  0.05 6 0.0  !chi1 N-CA-CB1-NN1
DIHEdral CH3E CH0  CH2E NPA   MULT 6  0.5 1 0.0  0.4 2 0.0  0.3 3 0.0  0.2 4 0.0  0.1 5 0.0  0.05 6 0.0  !chi1 CB2-CA-CB1-NN1
DIHEdral CH0  CH2E NPA  NPB   2.00  3  0.0000  ! chi2 CA-CB1-NN1=NN2 (ADI)
DIHEdral HA   CH2E NPA  NPB   2.00  3  0.0000  ! HB stagger vs azide (ADI/AZH)

! AZH-specific params: CB(CH2E)-CG(CH2E)-NN1(NPA) geometry
ANGLe CH2E CH2E NPA   500.00  111.0    ! CB-CG-NN1 (sp3 C to azide N)
IMPRoper HA   HA   CH2E NPA   500.000 {sd=     0.031}  0  35.2640  ! stereo CG in AZH (HG1 HG2 CB NN1)
DIHEdral CH1E CH2E CH2E NPA   MULT 6  0.5 1 0.0  0.4 2 0.0  0.3 3 0.0  0.2 4 0.0  0.1 5 0.0  0.05 6 0.0  ! AZH chi1 CA-CB-CG-NN1
DIHEdral HA   CH2E CH2E NPA   2.00  3  0.0000  ! AZH HB stagger vs CG
DIHEdral CH2E CH2E NPA  NPB   2.00  3  0.0000  ! AZH chi2 CB-CG-NN1=NN2

 ! added by M. Reau 01-06-21
 DIHEdral  HA   CH3E NH1  H      1.00     3  0.0000 !NME

 ! added by Aart Nederveen July 3 2003
 DIHEdral  HA   CH3E CH1E CCIS      1.00     3  0.0000 !Ala

! N and C terminal groups (ace planarity taken care of by peptide bond added 12-MAR-00)

 DIHEdral  HC   NH3  CH1E CCIS   2.00     3  0.0000 !Non-Gly/Pro N-terminus
 DIHEdral  HC   NH3  CH1E C      2.00     3  0.0000 !Non-Gly/Pro N-terminus
 DIHEdral  HC   NH3  CH2G C      2.00     3  0.0000 !Gly N-terminus
 DIHEdral  HC   NH3  CH2G CCIS   2.00     3  0.0000 !Gly/Pro N-terminus
 DIHEdral  OC   C    CH1E NH1    2.00     2  0.0000 !Non-Gly/Pro COO-terminus 
 DIHEdral  O    C    CH1E NH1    2.00     2  0.0000 
 DIHEdral  O    C    CH2G NH1    2.00     2  0.0000 !for iso-peptidebond with GLY (AB 2015-10)
 DIHEdral  O    C    CH2G NH2    2.00     2  0.0000 !for iso-peptidebond with GLY (AB 2015-10)
